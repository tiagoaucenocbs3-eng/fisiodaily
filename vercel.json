{
  "version": 2,
  "builds": [
    {
      "src": "api/whatsapp.js",
      "use": "@vercel/node"
    },
    {
      "src": "!(api|test)/**",
      "use": "@vercel/static"
    },
    {
      "src": "*.*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/whatsapp",
      "dest": "/api/whatsapp.js"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
