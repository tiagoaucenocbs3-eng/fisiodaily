# ========================================================
# CONFIGURACIÓN DEL REDIRECCIONADOR DE WHATSAPP (ROUND ROBIN)
# ========================================================

# Lista de números de WhatsApp registrados en formato internacional:
# Código de País + Código de Área/LADA + Número (solo dígitos, separados por comas)
# Ejemplo para México (52 + 1 + 10 dígitos o 52 + 10 dígitos):
WHATSAPP_NUMBERS=5215512345678,5215587654321,5215598765432

# Mensaje automático inicial enviado en WhatsApp (en Español de México)
WHATSAPP_MESSAGE=Hola, vi el anuncio y me gustaría recibir más información.

# ========================================================
# CREDENCIALES DE UPSTASH REDIS (O VERCEL KV)
# ========================================================
# Obténlas gratis en: https://console.upstash.com
UPSTASH_REDIS_REST_URL=https://tu-base-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=tu_token_aqui
